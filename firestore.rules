rules_version = '2';

// v2 rules for the Quiz + Practice Test platform. Replaced the v1
// course/enrollment/certificate rules on 2026-08-22 — see
// firestore.rules.pre-quiz-rebuild.bak for the old version and
// functions/src/_migrated-v1-reference/README.md for why.
//
// Design note (unchanged from v1): writes to every collection that needs
// server-trusted logic (grading, counters, answer-key visibility, role
// changes) are denied here and only happen through the Vercel functions in
// frontend/api/, which run under the Admin SDK and bypass these rules
// entirely. Rules below exist to gate *reads* correctly and to allow a small
// set of genuinely self-service *writes* (a student editing their own safe
// profile fields).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    // Role lives on the Firestore users/{uid} doc, not an ID-token custom
    // claim — this is what lets an admin account be created (or promoted)
    // entirely from the Firebase Console (Auth tab: add user; Firestore
    // tab: set role:'admin' on their users/{uid} doc), with no Admin SDK
    // script required. Costs one extra get() per rule check that calls
    // isAdmin(), which is fine at this app's scale.
    function role() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Partner Commission Framework staff roles. isFinance() is the only
    // sub-role added in Phase 1 (payout maker/checker in Phase 4); admin is
    // always a superset. isStaff() = "may read partner/commission data".
    function isFinance() { return isSignedIn() && role() == 'finance_admin'; }
    function isStaff() { return isAdmin() || isFinance(); }

    // --- users/{uid} ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Created via the Admin SDK only — api/auth.ts (register or
      // provisionProfile), never a client write.
      allow create: if false;
      // Self-service profile edit, restricted to an explicit safe-field
      // allow-list — role/isActive can only move through api/admin.ts.
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatarUrl', 'department', 'yearOfAdmission', 'currentAcademicYear', 'updatedAt']);
      allow delete: if false; // soft-delete (isActive=false) only, via api/admin.ts
    }

    // --- quizzes/{quizId} ---
    match /quizzes/{quizId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isPublished == true);
      allow write: if false; // api/content-admin.ts only

      match /questions/{questionId} {
        // Public doc never contains the answer, so any signed-in user may
        // read it once the parent quiz is published.
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.isPublished == true);
        allow write: if false; // api/content-admin.ts only

        match /private/answerKey {
          allow read: if isAdmin(); // never client-readable by a student
          allow write: if false;
        }
      }
    }

    // --- practiceTests/{testId} ---
    match /practiceTests/{testId} {
      // Not gated to the availability window: a rule condition on
      // resource.data here would need a matching range where() clause on
      // *two* different timestamp fields at once for Firestore to allow the
      // list query at all (it can't statically verify an unconstrained scan
      // against a resource.data comparison) — and the student UI needs to
      // list expired/upcoming tests too (see PracticeTestsPage.tsx), so the
      // window check happens client-side instead. Nothing sensitive lives on
      // this doc (title/dates/counts), unlike the private answer-key below.
      allow read: if isAdmin() || isSignedIn();
      allow write: if false; // api/content-admin.ts only

      match /questions/{questionId} {
        allow read: if isAdmin() || isSignedIn();
        allow write: if false; // api/content-admin.ts only

        match /private/answerKey {
          allow read: if isAdmin();
          allow write: if false;
        }
      }
    }

    // --- quizAttempts/{attemptId} (+ answers/{questionId}) ---
    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // api/quiz-session.ts only (grading is server-trusted)

      match /answers/{questionId} {
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/quizAttempts/$(attemptId)).data.userId == request.auth.uid);
        allow write: if false;
      }
    }

    // --- practiceSessions/{sessionId} (+ answers/{questionId}) ---
    match /practiceSessions/{sessionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // api/practice-session.ts only

      match /answers/{questionId} {
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/practiceSessions/$(sessionId)).data.userId == request.auth.uid);
        allow write: if false;
      }
    }

    // --- practiceProgress/{uid_testId} ---
    match /practiceProgress/{progressId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // api/practice-session.ts only
    }

    // --- studyPlans/{uid_testId} ---
    // Personal Study Planner (Phase 1). Written only by
    // api/practice-session.ts's saveStudyPlan (Admin SDK, bypasses these
    // rules) — this just needs to let a learner read back their own plan
    // (StudyPlanSetupPage's "you already have a plan" check, and the Home
    // dashboard's StudyPlanSection), same shape as practiceProgress above.
    match /studyPlans/{planId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // --- studyMilestones/{uid_testId_milestoneKey} ---
    // Same Phase 1 feature, step 4 (not yet built) — celebration records are
    // write-once via the backend; a learner only ever needs to read their
    // own, to know which have already been shown.
    match /studyMilestones/{milestoneId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // --- referrals/{refereeUid} ---
    // Refer & Earn. Doc id is the referred account's own uid. Written only
    // by api/auth.ts (pending, at signup) and api/checkout.ts/
    // api/razorpay-webhook.ts (rewarded, on the referee's first paid
    // order) — all Admin SDK, bypassing these rules. A learner can read
    // their own referral history either as the referrer (My Profile's
    // Refer & Earn list) or, in principle, as the referee.
    match /referrals/{refereeUid} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid));
      allow write: if false;
    }

    // --- coupons/{code} ---
    // Written only by api/coupons.ts (admin-created codes) and by
    // api/auth.ts/api/checkout.ts/api/razorpay-webhook.ts (Refer & Earn
    // reward coupons) — all Admin SDK, bypassing these rules. A learner
    // can only ever read a coupon that was minted specifically for them
    // (restrictedToUserId), e.g. to check whether their own Refer & Earn
    // coupon has already been used (usedCount) — a regular admin-created
    // coupon (no restrictedToUserId) stays unreadable by anyone but an
    // admin, since a learner never needs to read one directly (they just
    // type the code and the backend validates it).
    match /coupons/{code} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.restrictedToUserId == request.auth.uid);
      allow write: if false;
    }

    // --- creditLedgerEntries/{orderId} ---
    // Refer & Earn's non-withdrawable credit ledger (the referrer's own
    // reward — see CreditLedgerEntryDoc). Written only by api/checkout.ts/
    // api/razorpay-webhook.ts (grant, spend) and api/admin.ts (refund
    // reversal) — all Admin SDK, bypassing these rules. A learner can only
    // ever read their own entries (as the referrer), for their own credit
    // balance display (see useMyCredits.ts) — never anyone else's.
    match /creditLedgerEntries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.referrerUid == request.auth.uid);
      allow write: if false;
    }

    // --- purchaseConsents/{orderId} ---
    // Write-once audit record of what a customer was shown and agreed to at
    // checkout (see PurchaseConsentDoc). Written only by api/checkout.ts and
    // patched once by api/razorpay-webhook.ts — both Admin SDK, bypassing
    // these rules. A learner can read back their own record; nobody writes
    // from the client.
    match /purchaseConsents/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // --- adminLogs/{logId} ---
    match /adminLogs/{logId} {
      allow read, write: if false; // read via api/admin.ts's listAdminLogs action only
    }

    // === Partner Commission Framework ===
    // Same design as everything above: every write goes through the Admin
    // SDK (api/admin.ts staff actions, api/auth.ts user/public actions), so
    // writes are denied here and these rules only gate reads.

    // A partner reads their own partners/{id} doc (the portal, Phase 3);
    // staff read any.
    match /partners/{partnerId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    // An applicant reads back their own application to see its status.
    match /partnerApplications/{appId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /partnerAgreements/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Full PAN / GSTIN / address. Admin-SDK only - no client, not even the
    // owning partner or staff, reads these directly. Staff see a masked
    // view through api/admin.ts; a full-PAN reveal is a dedicated audited
    // action gated on users/{uid}.canRevealPan (PRD 15).
    match /partnerApplicationKyc/{appId} {
      allow read, write: if false;
    }
    match /partnerKyc/{partnerId} {
      allow read, write: if false;
    }
    // One doc per processed Razorpay event - webhook idempotency.
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }
    match /refunds/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // === Creator / Content Partnership (Phase 4b) ===
    // A creator reads their own roles / contracts / assignments / earnings;
    // never another creator's. Staff read any. Writes are Admin-SDK only.
    match /partnerRoles/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /creatorContracts/{id} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /creatorAssignments/{id} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /earnings/{id} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /earningsLedger/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Written from 4b-2 onward; deny-all until then.
    match /contentSubmissions/{id} { allow read, write: if false; }
    match /contentReviews/{id} { allow read, write: if false; }
    match /contentItems/{id} {
      allow read: if isStaff();
      allow write: if false;
      match /versions/{v} { allow read: if isStaff(); allow write: if false; }
    }
    match /contentComplianceCases/{id} { allow read: if isStaff(); allow write: if false; }
    // products / offers are shown on the "become a partner" page.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /commissionPolicies/{policyId} {
      allow read: if isStaff();
      allow write: if false;
      match /versions/{versionId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
    // A partner reads their own codes (Promote page, Phase 3).
    match /referralCodes/{code} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /referralEvents/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /auditEvents/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Written from Phase 2 onward; deny-all read for now except staff.
    match /commissions/{id} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }
    match /commissionLedger/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /payoutBatches/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /payouts/{id} {
      allow read: if isStaff() ||
        (isSignedIn() && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.linkedUserId == request.auth.uid);
      allow write: if false;
    }

    // --- appSettings/company --- admin-editable public contact / legal
    // facts (entity, address, jurisdiction, support + grievance email,
    // phone) shown on the marketing/legal pages and the checkout consent
    // links. Publicly readable on purpose — an anonymous visitor viewing
    // /terms or /contact needs it, and nothing on it is sensitive. Written
    // only by api/admin.ts's updateCompanyInfo (Admin SDK, admin-gated).
    // This specific match is unioned with the /appSettings/{id} rule below,
    // so read is allowed here while every other appSettings doc stays
    // server-only.
    match /appSettings/company {
      allow read: if true;
      allow write: if false;
    }

    // --- appSettings/appearance --- global dark-mode feature flag
    // ({ darkModeEnabled: bool }). Publicly readable so the SPA can decide
    // at boot whether to honor a saved dark preference (see
    // src/features/appearance/loadAppearance.ts); nothing on it is
    // sensitive. Written only by api/admin.ts's updateAppSettings
    // (Admin SDK, admin-gated).
    match /appSettings/appearance {
      allow read: if true;
      allow write: if false;
    }

    // --- appSettings/partnerFramework --- { enabled, applicationsOpen }.
    // Signed-in read so the SPA can decide whether to show the "become a
    // partner" entry / route. Written only by api/admin.ts's
    // updateAppSettings (Admin SDK, admin-gated). Unioned with the
    // catch-all below, same pattern as /appSettings/appearance.
    match /appSettings/partnerFramework {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- appSettings/{id} --- e.g. appSettings/general: emailOtpEnabled,
    // mobileOtpEnabled. Read/written only via api/admin.ts's
    // getAppSettings/updateAppSettings actions (admin-gated there) — never
    // a direct client read, so this is fully server-only.
    match /appSettings/{id} {
      allow read, write: if false;
    }

    // --- emailOtps/{uid} --- pending email-verification code (hashed),
    // written and checked only by api/auth.ts (register/verifyEmailOtp/
    // resendEmailOtp) — never client-readable, even by its own owner (no
    // reason for a signed-in-but-unverified session to see its own hash).
    match /emailOtps/{uid} {
      allow read, write: if false;
    }
  }
}
